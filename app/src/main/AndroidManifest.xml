<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 配置应用内下载订阅使用 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Root 模式常驻前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="gkdX"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- LSPosed 模块声明 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="进程内运行 GKD 订阅规则跳广告（无需无障碍）+ 可对外隐藏 GKD 无障碍状态" />
        <meta-data android:name="xposedminversion" android:value="53" />
        <!-- 允许 Hook 侧通过 XSharedPreferences 读取订阅数据 -->
        <meta-data android:name="xposedsharedprefs" android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GKDX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RootTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="gkdX Root 跳广告"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".RootEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the ad-skipping rule engine running in the background" />
        </service>
    </application>
</manifest>
